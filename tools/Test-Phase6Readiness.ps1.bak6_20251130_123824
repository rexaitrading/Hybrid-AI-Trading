param(
    [int] $DaysBack = 5
)

$ErrorActionPreference = 'Stop'

Write-Host "`n[PHASE6] Phase-6 readiness check (NVDA/SPY/QQQ Phase-5 package)" -ForegroundColor Cyan

# Determine repo root: tools/ -> repo root
$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$repoRoot  = Split-Path -Parent $scriptDir
Set-Location $repoRoot

# 1) Basic file existence checks
$requiredFiles = @(
    'tools\Run-Phase5Daily.ps1',
    'tools\Phase5_DailyLiveReport.ps1',
    'tools\phase5_gating_helpers.py',
    'config\phase5\ev_simple.json'
)

$allFilesOk = $true
Write-Host "`n[CHECK] Required files:" -ForegroundColor Yellow
foreach ($rel in $requiredFiles) {
    $full = Join-Path $repoRoot $rel
    if (Test-Path $full) {
        Write-Host "  [OK] $rel" -ForegroundColor Green
    } else {
        Write-Host "  [MISS] $rel" -ForegroundColor Red
        $allFilesOk = $false
    }
}

# 2) Check EV config for NVDA/SPY/QQQ entries
$evPath = Join-Path $repoRoot 'config\phase5\ev_simple.json'
$evMap  = $null
$evOk   = $false
if (Test-Path $evPath) {
    try {
        $evJson = Get-Content $evPath -Raw
        $evMap  = $evJson | ConvertFrom-Json
        $keys   = @('NVDA_BPLUS_LIVE','SPY_ORB_LIVE','QQQ_ORB_LIVE')
        $missing = @()
        foreach ($k in $keys) {
            if ($null -eq $evMap.$k) { $missing += $k }
        }
        if ($missing.Count -eq 0) {
            Write-Host "`n[CHECK] ev_simple.json contains NVDA/SPY/QQQ regimes" -ForegroundColor Green
            $evOk = $true
        } else {
            Write-Host "`n[CHECK] ev_simple.json missing regimes: $($missing -join ', ')" -ForegroundColor Red
        }
    } catch {
        Write-Host "`n[ERROR] Failed to parse ev_simple.json: $_" -ForegroundColor Red
    }
}

# 3) Check Phase-5 daily summary files exist (but do NOT parse them for regimes anymore)
$logsDir = Join-Path $repoRoot 'logs'
$summaryPattern = 'phase5_live_summary_*.txt'
$summaryFiles = Get-ChildItem -Path $logsDir -Filter $summaryPattern -ErrorAction SilentlyContinue |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First $DaysBack

if (-not $summaryFiles -or $summaryFiles.Count -eq 0) {
    Write-Host "`n[CHECK] No phase5_live_summary_*.txt files found in last $DaysBack days." -ForegroundColor Red
} else {
    Write-Host "`n[CHECK] Found $($summaryFiles.Count) Phase-5 summary file(s) (last $DaysBack days):" -ForegroundColor Yellow
    foreach ($f in $summaryFiles) {
        Write-Host "  $($f.Name)" -ForegroundColor Gray
    }
}

# 4) Coverage check from CSVs: does each LIVE regime appear in its CSV?
$symbolNames = @('NVDA_BPLUS_LIVE', 'SPY_ORB_LIVE', 'QQQ_ORB_LIVE')
$csvMap = @{
    'NVDA_BPLUS_LIVE' = 'logs\nvda_phase5_paper_for_notion.csv'
    'SPY_ORB_LIVE'    = 'logs\spy_phase5_paper_for_notion.csv'
    'QQQ_ORB_LIVE'    = 'logs\qqq_phase5_paper_for_notion.csv'
}
$coverage = @{}

foreach ($sym in $symbolNames) { $coverage[$sym] = $false }

Write-Host "`n[CHECK] Regime coverage in Phase-5 LIVE CSVs:" -ForegroundColor Yellow

foreach ($sym in $symbolNames) {
    $relCsv = $csvMap[$sym]
    $csvFull = Join-Path $repoRoot $relCsv
    if (-not (Test-Path $csvFull)) {
        Write-Host "  [MISS] $sym: CSV not found ($relCsv)" -ForegroundColor Red
        continue
    }

    try {
        $rows = Import-Csv $csvFull
    } catch {
        Write-Host "  [ERROR] $sym: failed to Import-Csv $relCsv : $_" -ForegroundColor Red
        continue
    }

    $hasRegime = $false
    foreach ($r in $rows) {
        if ($r.PSObject.Properties['regime'] -ne $null -and $r.regime -eq $sym) {
            $hasRegime = $true
            break
        }
    }

    if ($hasRegime) {
        Write-Host "  [OK] $sym present in $relCsv" -ForegroundColor Green
        $coverage[$sym] = $true
    } else {
        Write-Host "  [MISS] $sym not found in $relCsv" -ForegroundColor Red
    }
}

# 5) Final verdict (high-level)
$allSymbolsCovered = ($coverage.Values -notcontains $false)

Write-Host "`n[RESULT] Phase-6 readiness (heuristic):" -ForegroundColor Cyan
if ($allFilesOk -and $evOk -and $summaryFiles.Count -gt 0 -and $allSymbolsCovered) {
    Write-Host "  -> TECHNICALLY READY CANDIDATE: Core Phase-5 shell is present and running for NVDA/SPY/QQQ." -ForegroundColor Green
    Write-Host "  -> HUMAN CHECK: Confirm EV values are data-derived and gates (no-averaging, EV, loss caps) behave in micro-size." -ForegroundColor Yellow
} else {
    Write-Host "  -> NOT READY: Some Phase-5 building blocks or recent summaries are missing." -ForegroundColor Red
    Write-Host "     Fix the red items above before declaring Phase 6 started." -ForegroundColor Yellow
}